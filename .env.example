# Copiar a .env.local (desarrollo) o configurar en el hosting (Vercel, etc.).
# Nunca subir el archivo .env.local al repositorio.

# Dominio oficial (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # SOLO servidor. No usar prefijo NEXT_PUBLIC_.

# Correos (opcional) – https://resend.com
RESEND_API_KEY=
MAIL_FROM=                   # ej: "Tritotal Team <inscripciones@tu-dominio.cl>" (dominio verificado en Resend)
ADMIN_EMAIL=totalteamchile@gmail.com   # quien recibe el aviso de cada nueva inscripción
